{
  "version": 1,
  "name": "ossify-spine",
  "params": ["spine", "spine_branch", "spine_dir", "ai_root", "ai_project", "repo", "project", "state_file", "oss", "briefs"],
  "slots": { "session": 2, "build": 1 },
  "sources": [
    {
      "dir": "{run.dir}/queue",
      "id_key": "work_item_id",
      "group_key": "round",
      "order_key": "order",
      "vars": { "worktree_path": "worktree_path", "branch": "branch", "handoff_path": "handoff_path", "base_sha": "base_sha", "pr_url": "pr_url" },
      "stage": "implement"
    },
    {
      "dir": "{run.dir}/spine",
      "id_key": "id",
      "group_key": "group",
      "order_key": "order",
      "vars": { "pr_url": "pr_url" },
      "stage": "spine_review"
    }
  ],
  "seed": [{ "id": "lane", "stage": "lane" }],
  "driver": {
    "kind": "driver",
    "role": "driver",
    "project": "{param.ai_project}",
    "cwd": "{param.ai_root}",
    "launch_dir": "worktree",
    "title": "driver {unit.id}",
    "message": "Read {param.briefs}/driver.md and follow it. Unit: {unit.id}. Parked in: {driver.stage}. Reason: {driver.reason}. State file: {run.dir}/out/{unit.id}/driver-state.md. Result file: {run.dir}/out/{unit.id}/driver-result-{driver.launch}.json. Briefs: {param.briefs}. Spine: {param.spine_dir}.",
    "env": {
      "SEAT_MODS_ROLE": "reviewer",
      "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}"
    },
    "stall_minutes": 15,
    "state_file": "{run.dir}/out/{unit.id}/driver-state.md",
    "result_file": "{run.dir}/out/{unit.id}/driver-result-{driver.launch}.json",
    "ledger": "{param.spine_dir}/autopilot-ledger.md",
    "clearing": ["rerun-check", "remove-file"],
    "resume_to": { "correct": ["verify"] }
  },
  "stages": {
    "lane": {
      "kind": "session",
      "role": "spine session",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "lane {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/lane.md, and follow them. Spine: {param.spine}. Queue directory: {run.dir}/queue. OUT: {run.dir}/out/{unit.id}. Lane done file: {run.dir}/out/{unit.id}/lane.done. Rounds done file: {run.dir}/rounds.done. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/rounds.done" }],
          "to": "spine_open",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        },
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/lane.done" },
            { "units": { "group": "{run.group}", "stages": ["implement", "gap_wait", "regap", "verify", "close", "correct", "item_ready", "item_review", "item_wait", "item_moved", "item_fix", "land"], "count": "none" } }
          ],
          "to": "park",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/lane.done" }],
          "to": "lane_wait",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        }
      ]
    },
    "lane_wait": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "units": { "group": "{run.group}", "stages": ["done"], "count": "all" } }], "to": "lane" }
      ]
    },
    "implement": {
      "kind": "session",
      "role": "implementer",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "implement {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/implement.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Report: {param.spine_dir}/work-{unit.id}/report.md. OUT: {run.dir}/out/{unit.id}. Gaps file: {run.dir}/out/{unit.id}/gaps.json. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{param.spine_dir}/work-{unit.id}:{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [
        ["mkdir", "-p", "{run.dir}/out/{unit.id}"],
        ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.dispatches // 0) < 3)", "{param.state_file}"], ["rm", "-f", "{run.dir}/out/{unit.id}/gaps.json"]
      ],
      "after_launch": [["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_dispatched", "{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "file": "{param.spine_dir}/work-{unit.id}/report.md" }], "to": "verify" },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/gaps.json" }], "to": "gap_wait" }
      ]
    },
    "gap_wait": {
      "kind": "wait",
      "outcomes": [
        {
          "when": [
            { "active": "none-in-group" },
            { "units": { "group": "{run.group}", "stages": ["implement", "regap", "verify", "close", "correct"], "count": "none" } }
          ],
          "to": "regap"
        }
      ]
    },
    "regap": {
      "kind": "session",
      "role": "spine session",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "regap {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/regap.md, and follow them. Spine: {param.spine}. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Gaps record: {run.dir}/out/{unit.id}/gaps.json. Request record to rewrite: {run.dir}/queue/{unit.id}.json. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "record_changed": true }], "to": "implement" }
      ]
    },
    "verify": {
      "kind": "session",
      "role": "verifier",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "verify {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/verify.md, and follow them. Your agent name: {agent.name}. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Report: {param.spine_dir}/work-{unit.id}/report.md. Worktree: {unit.vars.worktree_path}. Base SHA: {unit.vars.base_sha}. Verdict file: {run.dir}/out/{unit.id}/verdict.json. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop.",
      "env": {
        "SEAT_MODS_ROLE": "verifier",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OSSIFY_VERIFY_WORKTREE": "{unit.vars.worktree_path}",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"], ["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "verdict", ".json"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": null,
      "outcomes": [
        { "when": [{ "file": "{run.dir}/out/{unit.id}/verdict.json" }], "to": "close" }
      ]
    },
    "close": {
      "kind": "session",
      "role": "close session",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root", "title": "close {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/close.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Worktree: {unit.vars.worktree_path}. Branch: {unit.vars.branch}. Base SHA: {unit.vars.base_sha}. Verdict file: {run.dir}/out/{unit.id}/verdict.json. Correction packet: {run.dir}/out/{unit.id}/correction.txt. Ruling file: {run.dir}/out/{unit.id}/operator.md. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "exit0": ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.pr_url | type) == \"string\")", "{param.state_file}"] }],
          "to": "item_ready",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"], ["sh", "-c", "u=$(jq -er --arg w \"$2\" '.work_items[] | select(.id == $w) | .pr_url' \"$1\") && jq --arg u \"$u\" '.pr_url = $u' \"$3\" > \"$3.tmp\" && mv -- \"$3.tmp\" \"$3\"", "sh", "{param.state_file}", "{unit.id}", "{run.dir}/queue/{unit.id}.json"]]
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/correction.txt" }],
          "to": "correct",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"]]
        }
      ]
    },
    "correct": {
      "kind": "session",
      "role": "implementer",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "correct {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/correct.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Correction packet: {run.dir}/out/{unit.id}/correction.txt. Corrected file: {run.dir}/out/{unit.id}/corrected. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{param.spine_dir}/work-{unit.id}:{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [
        ["mkdir", "-p", "{run.dir}/out/{unit.id}"],
        ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.dispatches // 0) < 3)", "{param.state_file}"], ["rm", "-f", "{run.dir}/out/{unit.id}/corrected"]
      ],
      "after_launch": [["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_dispatched", "{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/corrected" }],
          "to": "verify",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "correction", ".txt"], ["rm", "-f", "{run.dir}/out/{unit.id}/corrected"]]
        }
      ]
    },
    "land": {
      "kind": "merge",
      "pr": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"],
      "base": "{param.spine_branch}",
      "repo": "{param.repo}",
      "expect_head": ["sed", "-n", "2s/^head: //p", "{run.dir}/out/{unit.id}/review.md"],
      "ordered": true,
      "checks": "green",
      "outcomes": { "merged": "done", "red": "park", "conflict": "park", "moved": "item_moved" },
      "run_after": [
        ["sh", "-c", "test \"$(git -C \"$1\" symbolic-ref --short HEAD)\" = \"$2\"", "sh", "{param.repo}", "{param.spine_branch}"],
        ["git", "-C", "{param.repo}", "merge", "--ff-only", "origin/{param.spine_branch}"],
        ["git", "-C", "{param.repo}", "merge-base", "--is-ancestor", "{pr.head}", "{param.spine_branch}"],
        ["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_status", "{unit.id}", "complete"]
      ]
    },
    "item_ready": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "exit0": ["jq", "-e", "(.pr_url | type) == \"string\" and (.pr_url | test(\"^https://\\\\S+/pull/[0-9]+\\\\z\"))", "{run.dir}/queue/{unit.id}.json"] }], "to": "item_review" },
        { "when": [{ "exit0": ["jq", "-e", ".pr_url != null", "{run.dir}/queue/{unit.id}.json"] }], "to": "park" }
      ]
    },
    "item_review": {
      "kind": "session",
      "role": "item reviewer",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "item review {unit.id}",
      "message": "{agent.review} {unit.vars.pr_url} previous: {run.dir}/out/{unit.id}/review-prev.md Then read {param.briefs}/common.md and {param.briefs}/item-review.md, and write {run.dir}/out/{unit.id}/review.md whose first line is exactly verdict: pass or verdict: block, whose second line is head: followed by the reviewed head SHA (40 hex), then the findings. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "reviewer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"], ["sh", "-c", "[ -e \"$1/review.md\" ] || exit 0; if sed -n 1p \"$1/review.md\" | grep -qxE 'verdict: (pass|block)' && sed -n 2p \"$1/review.md\" | grep -qxE 'head: [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]'; then cp -f -- \"$1/review.md\" \"$1/review-prev.md\"; f=review; else f=review-bad; fi; n=1; while [ -e \"$1/$f-$n.md\" ]; do n=$((n+1)); done; mv -- \"$1/review.md\" \"$1/$f-$n.md\"", "sh", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/review.md" },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: (pass|block)"] },
            { "exit0": ["sh", "-c", "sed -n 2p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "head: [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]"] }
          ],
          "to": "item_wait"
        }
      ]
    },
    "item_wait": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "merged" } }], "to": "land" },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/review-2.md" }, { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: block"] }], "to": "park" },
        { "when": [{ "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "closed" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "conflict" } }], "to": "park" },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/review-2.md" }, { "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "checks_red" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "checks_red" } }], "to": "item_fix" },
        {
          "when": [
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: block"] },
            { "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "checks_green" } }
          ],
          "to": "item_fix"
        },
        {
          "when": [
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: pass"] },
            { "pr": { "url": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"], "test": "checks_green" } }
          ],
          "to": "land"
        }
      ]
    },
    "item_moved": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "file": "{run.dir}/out/{unit.id}/review-2.md" }], "to": "park" },
        { "when": [], "to": "item_review" }
      ]
    },
    "item_fix": {
      "kind": "session",
      "role": "work-PR session",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "item fix {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/item-fix.md, and follow them. Item PR: {unit.vars.pr_url}. Review: {run.dir}/out/{unit.id}/review.md. Ruling file: {run.dir}/out/{unit.id}/operator.md. Round done file: {run.dir}/out/{unit.id}/round-done. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/round-done" }],
          "to": "item_review",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"], ["rm", "-f", "{run.dir}/out/{unit.id}/round-done"]]
        }
      ]
    },
    "spine_open": {
      "kind": "session",
      "role": "close session",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "spine open {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-open.md, and follow them. Spine: {param.spine}. Spine PR record: {run.dir}/spine/spine-pr.json. Ruling file: {run.dir}/out/{unit.id}/operator.md. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "file": "{run.dir}/spine/spine-pr.json" }], "to": "done", "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"]] }
      ]
    },
    "spine_review": {
      "kind": "session",
      "role": "reviewer",
      "project": "{param.project}",
      "cwd": "{param.repo}",
      "launch_dir": "worktree",
      "title": "spine review {param.spine}",
      "message": "{agent.review} {unit.vars.pr_url} previous: {run.dir}/out/{unit.id}/review-prev.md Then read {param.briefs}/common.md and {param.briefs}/spine-review.md, and write {run.dir}/out/{unit.id}/review.md whose first line is exactly verdict: pass or verdict: block, whose second line is head: followed by the reviewed head SHA (40 hex), then the findings. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "reviewer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/review.md" },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: (pass|block)"] },
            { "exit0": ["sh", "-c", "sed -n 2p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "head: [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]"] }
          ],
          "to": "spine_wait"
        }
      ]
    },
    "spine_wait": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "merged" } }], "to": "spine_finish" },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/review-2.md" }, { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: block"] }], "to": "park" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "closed" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "conflict" } }], "to": "park" },
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/review-stale-3.md" },
            { "file": "{run.dir}/out/{unit.id}/review.md" },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: pass"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "open" } },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; case \"$2\" in *[!0-9a-f]*|\"\") exit 2;; esac; [ \"$(expr \"$2\" : '.*')\" -eq 40 ] || exit 2; [ \"$(sed -n 2p \"$1\")\" != \"head: $2\" ]", "sh", "{run.dir}/out/{unit.id}/review.md", "{pr.head}"] }
          ],
          "to": "park"
        },
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/review.md" },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: pass"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "open" } },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; case \"$2\" in *[!0-9a-f]*|\"\") exit 2;; esac; [ \"$(expr \"$2\" : '.*')\" -eq 40 ] || exit 2; [ \"$(sed -n 2p \"$1\")\" != \"head: $2\" ]", "sh", "{run.dir}/out/{unit.id}/review.md", "{pr.head}"] }
          ],
          "to": "spine_review",
          "run": [["sh", "-c", "[ -e \"$1/review.md\" ] || exit 0; cp -f -- \"$1/review.md\" \"$1/review-prev.md\"; n=1; while [ -e \"$1/review-stale-$n.md\" ]; do n=$((n+1)); done; mv -- \"$1/review.md\" \"$1/review-stale-$n.md\"", "sh", "{run.dir}/out/{unit.id}"]]
        },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/review-2.md" }, { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_red" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_red" } }], "to": "spine_work" },
        {
          "when": [
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: block"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_green" } }
          ],
          "to": "spine_work"
        },
        {
          "when": [
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; sed -n 1p \"$1\" | grep -qxE \"$2\"", "sh", "{run.dir}/out/{unit.id}/review.md", "verdict: pass"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_green" } },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "mergeable" } },
            { "exit0": ["sh", "-c", "[ -r \"$1\" ] || exit 2; case \"$2\" in *[!0-9a-f]*|\"\") exit 2;; esac; [ \"$(expr \"$2\" : '.*')\" -eq 40 ] || exit 2; [ \"$(sed -n 2p \"$1\")\" = \"head: $2\" ]", "sh", "{run.dir}/out/{unit.id}/review.md", "{pr.head}"] }
          ],
          "to": "spine_ack",
          "notify": "Spine {param.spine} PR {unit.vars.pr_url} passed review and is green and mergeable: read its needs-you list and any CodeRabbit thread newer than the last push, then merge it only where the project's governance grants that, else ask the operator."
        }
      ]
    },
    "spine_work": {
      "kind": "session",
      "role": "work-PR session",
      "project": "{param.project}",
      "cwd": "{param.repo}",
      "launch_dir": "root",
      "title": "spine work {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-work.md, and follow them. Spine PR: {unit.vars.pr_url}. Review: {run.dir}/out/{unit.id}/review.md. Ruling file: {run.dir}/out/{unit.id}/operator.md. Round done file: {run.dir}/out/{unit.id}/round-done. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}:{param.spine_dir}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/round-done" }],
          "to": "spine_review",
          "run": [["sh", "-c", "[ -e \"$1/review.md\" ] || exit 0; cp -f -- \"$1/review.md\" \"$1/review-prev.md\"", "sh", "{run.dir}/out/{unit.id}"], ["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "review", ".md"], ["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"], ["rm", "-f", "{run.dir}/out/{unit.id}/round-done"]]
        }
      ]
    },
    "spine_ack": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "merged" } }], "to": "spine_finish" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "closed" } }], "to": "park" }
      ]
    },
    "spine_close_wait": {
      "kind": "wait",
      "outcomes": [
        {
          "when": [
            { "pr": { "url": ["sed", "-n", "1p", "{run.dir}/out/{unit.id}/close-pr.txt"], "test": "merged" } },
            { "exit0": ["sh", "-c", "d=$(dirname -- \"$1\"); b=$(basename -- \"$1\"); GIT_TERMINAL_PROMPT=0 git -C \"$d\" fetch -q origin main || exit 2; s=$(git -C \"$d\" show \"origin/main:./$b\") || exit 2; printf '%s\\n' \"$s\" | jq -e --arg s \"$2\" '.spines[] | select(.id == $s) | .status == \"closed\"' >/dev/null; r=$?; [ \"$r\" -le 1 ] || exit 2; exit \"$r\"", "sh", "{param.state_file}", "{param.spine}"] }
          ],
          "to": "done",
          "notify": "AI close PR for {param.spine} is merged and origin/main reads the spine closed: pull the AI workspace root (move an untracked ledger aside first)."
        },
        { "when": [{ "pr": { "url": ["sed", "-n", "1p", "{run.dir}/out/{unit.id}/close-pr.txt"], "test": "merged" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["sed", "-n", "1p", "{run.dir}/out/{unit.id}/close-pr.txt"], "test": "closed" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["sed", "-n", "1p", "{run.dir}/out/{unit.id}/close-pr.txt"], "test": "conflict" } }], "to": "park" }
      ]
    },
    "spine_finish": {
      "kind": "session",
      "role": "close session",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "spine finish {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-finish.md, and follow them. Spine: {param.spine}. Spine PR: {unit.vars.pr_url}. Ruling file: {run.dir}/out/{unit.id}/operator.md. OUT: {run.dir}/out/{unit.id}. Out root: {run.dir}/out. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "exit0": ["sh", "-c", "d=$(dirname -- \"$1\"); b=$(basename -- \"$1\"); GIT_TERMINAL_PROMPT=0 git -C \"$d\" fetch -q origin main || exit 2; s=$(git -C \"$d\" show \"origin/main:./$b\") || exit 2; printf '%s\\n' \"$s\" | jq -e --arg s \"$2\" '.spines[] | select(.id == $s) | .status == \"closed\"' >/dev/null; r=$?; [ \"$r\" -le 1 ] || exit 2; exit \"$r\"", "sh", "{param.state_file}", "{param.spine}"] }],
          "to": "done",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"]],
          "notify": "The AI close for {param.spine} is on origin/main. Harvest candidates, if the seat wrote any, are in {run.dir}/out/{unit.id}/harvest.md: present them to the operator, then apply the accepted set (ossify harvest §7) as a follow-up commit."
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/close-pr.txt" }],
          "to": "spine_close_wait",
          "run": [["sh", "-c", "[ -e \"$1/$2$3\" ] || exit 0; n=1; while [ -e \"$1/$2-$n$3\" ]; do n=$((n+1)); done; mv -- \"$1/$2$3\" \"$1/$2-$n$3\"", "sh", "{run.dir}/out/{unit.id}", "operator", ".md"]],
          "notify": "The AI close PR for {param.spine} is recorded in {run.dir}/out/{unit.id}/close-pr.txt: review and merge it as the project's governance grants, else ask the operator. baton then reads origin/main for the closed spine. Harvest candidates are in {run.dir}/out/{unit.id}/harvest.md and under ## Harvest candidates in its body: present them to the operator, then apply the accepted set (ossify harvest §7) on its branch before the merge."
        }
      ]
    }
  }
}
